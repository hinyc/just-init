# Production 환경변수 (커밋 대상, 비밀값 금지)
# npm run build / npm run dev:prod / npm run start 가 이 파일을 읽습니다.
# 실제 비밀값은 배포 플랫폼(Vercel 등) 또는 .env.local에서 주입하세요.
# NODE_ENV 는 Next.js 가 명령에 맞게 자동 설정하므로 여기서 지정하지 않습니다.

NEXT_PUBLIC_APP_ENV=production
# BFF 엔드포인트 프리픽스. 같은 오리진이면 상대경로로 두는 것을 권장.
NEXT_PUBLIC_API_BASE_URL=/api

# DATABASE_URL은 호스팅 대시보드 또는 .env.local에서 설정하세요.
# DATABASE_URL=
