# Development 전용 환경변수 (커밋 대상, 비밀값 금지)
# npm run dev / npm run build:dev / npm run start:dev 가 이 파일을 읽습니다.
# NODE_ENV 는 Next.js 가 명령에 맞게 자동 설정하므로 여기서 지정하지 않습니다.

NEXT_PUBLIC_APP_ENV=development
# BFF 엔드포인트 프리픽스. 같은 오리진이면 상대경로로 두는 것을 권장.
NEXT_PUBLIC_API_BASE_URL=/api

# 로컬 개발용 DB. 실제 값은 .env.local에서 덮어쓰기 권장.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/just_init_dev
