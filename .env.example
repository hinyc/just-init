# .env.local 템플릿. 이 파일을 복사해서 .env.local 을 만드세요.
#     cp .env.example .env.local
#
# .env.local 은 .env.development / .env.production 보다 우선 적용됩니다.
# 개인별 시크릿·로컬 오버라이드만 여기에 넣습니다. (gitignored)

# 공용 개발 DB 대신 개인 DB를 쓸 때 오버라이드
# DATABASE_URL=postgres://user:password@localhost:5432/just_init

# 프로덕션 DB에 로컬에서 접근해야 할 때 (주의)
# DATABASE_URL=postgres://...

# 인증/외부 서비스 비밀값 예시
# AUTH_SECRET=
# OPENAI_API_KEY=

# 기본 API 베이스 URL 오버라이드
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
