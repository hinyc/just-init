{
  "name": "just-init",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env.local -e .env.development -- next dev",
    "dev:prod": "dotenv -e .env.local -e .env.production -- next dev",
    "dev:local": "dotenv -e .env.local -- next dev",
    "build": "dotenv -e .env.local -e .env.production -- next build",
    "build:dev": "dotenv -e .env.local -e .env.development -- next build",
    "build:local": "dotenv -e .env.local -- next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -e .env.development -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -e .env.development -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -e .env.development -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -e .env.development -- drizzle-kit studio"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
